---
// 全ページ共通: 左上のハンバーガー、左から出る「町の案内図」（ナビ。季節・配色の切替=町の天気もここ）、本体にかかる影
import site from '../data/site.json';
import { withBase } from '../lib/url';
import { PLACES } from '../lib/town';
const nav = PLACES.map((p) => ({ ...p, href: withBase(p.path) }));   // 項目は src/lib/town.ts
const themes = [{ key: 'yellow', label: '黄' }, { key: 'navy', label: '紺' }, { key: 'green', label: '緑' }, { key: 'black', label: '黒' }];
const seasons = [{ key: 'spring', label: '春' }, { key: 'summer', label: '夏' }, { key: 'autumn', label: '秋' }, { key: 'winter', label: '冬' }];
---
<header class="topbar">
  <button class="burger" id="burger" type="button" aria-label="メニューを開く" aria-expanded="false" aria-controls="drawer"><span></span></button>
</header>
<div class="shade" id="shade"></div>
<nav class="drawer" id="drawer" aria-label="メインナビゲーション" aria-hidden="true">
  <div class="drawer-head">
    <span class="brand"><b></b>M2D TOWN<small>案内図</small></span>
    <button class="drawer-close" id="drawer-close" type="button" aria-label="メニューを閉じる">×</button>
  </div>
  <ul>
    {nav.map((n) => <li><a href={n.href}><span class="en">{n.en}</span>{n.label}</a></li>)}
  </ul>
  <div class="drawer-weather">
    <span class="en">Weather · 町の天気</span>
    <div class="weather-row">
      <span class="w-label">季節</span>
      <div class="season-picker" role="group" aria-label="季節">
        {seasons.map((sn) => <button type="button" class="season-btn" data-season-key={sn.key}>{sn.label}</button>)}
      </div>
    </div>
    <div class="weather-row">
      <span class="w-label">空の色</span>
      <div class="theme-picker" role="group" aria-label="配色">
        {themes.map((t) => <button type="button" class="theme-dot" data-theme-key={t.key} title={'配色: ' + t.label} aria-label={'配色: ' + t.label}></button>)}
      </div>
    </div>
  </div>
  <p class="drawer-foot">{site.labName}｜{site.labNameAlt}<br /><span class="en">{site.universityEn}</span></p>
</nav>

<script>
  // ナビのモーダルと配色。要素はクリックのたびに探す（ページ切替で要素が入れ替わっても動く）
  const THEMES = ['yellow', 'navy', 'green', 'black'];
  const current = () => document.documentElement.dataset.theme || 'yellow';
  function setTheme(name) {
    document.documentElement.dataset.theme = name;
    try { localStorage.setItem('m2d-theme', name); } catch (e) {}
    markDots();
    document.dispatchEvent(new CustomEvent('m2d:theme', { detail: name }));
  }
  function markDots() {
    document.querySelectorAll('.theme-dot').forEach((b) => b.classList.toggle('on', b.dataset.themeKey === current()));
    document.querySelectorAll('.season-btn').forEach((b) => b.classList.toggle('on', b.dataset.seasonKey === currentSeason()));
  }
  const SEASONS = ['spring', 'summer', 'autumn', 'winter'];
  function seasonForDate() { const m = new Date().getMonth() + 1; return m <= 2 || m === 12 ? 'winter' : m <= 5 ? 'spring' : m <= 8 ? 'summer' : 'autumn'; }
  function currentSeason() { let sv = null; try { sv = localStorage.getItem('m2d-season'); } catch (e) {} return SEASONS.includes(sv) ? sv : seasonForDate(); }
  function setSeason(name) {
    try { localStorage.setItem('m2d-season', name); } catch (e) {}
    markDots();
    document.dispatchEvent(new CustomEvent('m2d:season', { detail: name }));
  }
  function setOpen(on) {
    const burger = document.getElementById('burger'), drawer = document.getElementById('drawer');
    document.body.classList.toggle('nav-open', on);
    if (burger) { burger.setAttribute('aria-expanded', String(on)); burger.setAttribute('aria-label', on ? 'メニューを閉じる' : 'メニューを開く'); }
    if (drawer) drawer.setAttribute('aria-hidden', String(!on));
  }
  if (!document.documentElement.dataset.navBound) {
    document.documentElement.dataset.navBound = '1';
    document.addEventListener('click', (e) => {
      const el = e.target instanceof Element ? e.target : null; if (!el) return;
      if (el.closest('#burger')) { setOpen(!document.body.classList.contains('nav-open')); return; }
      if (el.closest('#drawer-close') || el.closest('#shade') || el.closest('#drawer a')) { setOpen(false); }
      const dot = el.closest('.theme-dot'); if (dot) setTheme(dot.dataset.themeKey);
      const sb = el.closest('.season-btn'); if (sb) setSeason(sb.dataset.seasonKey);
    });
    addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
    // ページ切替後: 保存した配色を再適用し、メニューは閉じた状態に
    document.addEventListener('astro:after-swap', () => { try { const th = localStorage.getItem('m2d-theme'); if (THEMES.includes(th)) document.documentElement.dataset.theme = th; } catch (e) {} setOpen(false); });
    document.addEventListener('astro:page-load', markDots);
  }
  markDots();
</script>
