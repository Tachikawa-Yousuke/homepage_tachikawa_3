---
// 全ページ共通: 上部バー（ハンバーガー＋ロゴ＋配色）、左から出るナビのモーダル、影
import site from '../data/site.json';
import { withBase } from '../lib/url';
const nav = [
  { href: withBase('/'), label: 'ホーム', en: 'Home' },
  { href: withBase('/about'), label: '研究室概要', en: 'About' },
  { href: withBase('/research'), label: '研究テーマ', en: 'Research' },
  { href: withBase('/members'), label: 'メンバー', en: 'Members' },
  { href: withBase('/publications'), label: '業績', en: 'Publications' },
  { href: withBase('/equipment'), label: '装置・設備', en: 'Apparatus' },
  { href: withBase('/join'), label: '進学・配属', en: 'Join us' },
  { href: withBase('/access'), label: 'アクセス', en: 'Access' },
];
const themes = [{ key: 'yellow', label: '黄' }, { key: 'navy', label: '紺' }, { key: 'green', label: '緑' }, { key: 'black', label: '黒' }];
---
<header class="topbar" transition:persist="topbar">
  <button class="burger" id="burger" type="button" aria-label="メニューを開く" aria-expanded="false" aria-controls="drawer"><span></span></button>
  <a class="brand" href={withBase('/')}><b></b>M2D Lab</a>
  <div class="theme-picker" role="group" aria-label="配色">
    {themes.map((t) => <button type="button" class="theme-dot" data-theme-key={t.key} title={'配色: ' + t.label} aria-label={'配色: ' + t.label}></button>)}
  </div>
</header>
<div class="shade" id="shade" hidden></div>
<nav class="drawer" id="drawer" aria-label="メインナビゲーション" aria-hidden="true">
  <div class="drawer-head">
    <span class="brand"><b></b>M2D Lab</span>
    <button class="drawer-close" id="drawer-close" type="button" aria-label="メニューを閉じる">×</button>
  </div>
  <ul>
    {nav.map((n) => <li><a href={n.href}><span class="en">{n.en}</span>{n.label}</a></li>)}
  </ul>
  <p class="drawer-foot">{site.labName}｜{site.labNameAlt}<br /><span class="en">{site.universityEn}</span></p>
</nav>

<script>
  // ナビのモーダルと配色。ページ切替（View Transitions）後も動くよう astro:page-load で毎回結び直す
  const THEMES = ['yellow', 'navy', 'green', 'black'];
  const current = () => document.documentElement.dataset.theme || 'yellow';
  function setTheme(name) {
    document.documentElement.dataset.theme = name;
    try { localStorage.setItem('m2d-theme', name); } catch (e) {}
    document.querySelectorAll('.theme-dot').forEach((b) => b.classList.toggle('on', b.dataset.themeKey === name));
    document.dispatchEvent(new CustomEvent('m2d:theme', { detail: name }));
  }
  function bind() {
    const burger = document.getElementById('burger'), drawer = document.getElementById('drawer'), shade = document.getElementById('shade'), closeBtn = document.getElementById('drawer-close');
    if (!burger || burger.dataset.bound) return;
    burger.dataset.bound = '1';
    const open = (on) => {
      document.body.classList.toggle('nav-open', on);
      burger.setAttribute('aria-expanded', String(on)); burger.setAttribute('aria-label', on ? 'メニューを閉じる' : 'メニューを開く');
      drawer.setAttribute('aria-hidden', String(!on)); shade.hidden = !on;
    };
    burger.addEventListener('click', () => open(!document.body.classList.contains('nav-open')));
    shade.addEventListener('click', () => open(false));
    closeBtn.addEventListener('click', () => open(false));
    addEventListener('keydown', (e) => { if (e.key === 'Escape') open(false); });
    drawer.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => open(false)));
    document.querySelectorAll('.theme-dot').forEach((b) => b.addEventListener('click', () => setTheme(b.dataset.themeKey)));
    document.querySelectorAll('.theme-dot').forEach((b) => b.classList.toggle('on', b.dataset.themeKey === current()));
  }
  // ページ切替後に <html data-theme> が初期値に戻るので、保存した配色を再適用する
  document.addEventListener('astro:after-swap', () => { try { const th = localStorage.getItem('m2d-theme'); if (THEMES.includes(th)) document.documentElement.dataset.theme = th; } catch (e) {} });
  document.addEventListener('astro:page-load', bind);
  bind();
</script>
