---
// 文章ページ共通レイアウト（トップと同じ配色・ナビ。ページ切替は flipX）
import { ClientRouter } from 'astro:transitions';
import SiteChrome from '../components/SiteChrome.astro';
import site from '../data/site.json';
import { withBase } from '../lib/url';
import { placeFor } from '../lib/town';

interface Props { title: string; description?: string; en?: string; }
const { title, description = site.description, en = '' } = Astro.props;
const here = placeFor(Astro.url.pathname, import.meta.env.BASE_URL);   // この文章ページが町のどこに当たるか
const pageTitle = title + '｜' + site.labName + '（' + site.labNameAlt + '）';
---
<!doctype html>
<html lang="ja" data-theme="yellow">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href={withBase('/style.css')} />
    <script is:inline>
      try { var th = localStorage.getItem('m2d-theme'); if (['yellow', 'navy', 'green', 'black'].indexOf(th) >= 0) document.documentElement.dataset.theme = th; } catch (e) {}
    </script>
    <ClientRouter />
  </head>
  <body class="subpage">
    <canvas id="town-bg" class="town-bg" aria-hidden="true"></canvas>   <!-- 文章ページの背景にも町を薄く敷く（「町の中にいる」感じ） -->
    <SiteChrome />
    <div class="page-body">
      <main class="page wrap">
        <header class="page-head">
          {here && <p class="crumb"><a href={withBase('/')}>M2D TOWN</a><span aria-hidden="true">▸</span>{here.place}</p>}
          {en && <p class="label">{en}</p>}
          <h1>{title}</h1>
        </header>
        <div class="panel prose">
          <slot />
        </div>
      </main>
      <footer class="footer wrap">&copy; {new Date().getFullYear()} {site.labNameEn} / {site.universityEn}</footer>
    </div>
    <script>
      // 背景の町（軽量版）。トップと同じ模型を薄く敷き、季節・配色の切替にも追従する
      import { createDiorama } from '../scripts/diorama.js';
      let d = null;
      function init() {
        const c = document.getElementById('town-bg'); if (!c || c.dataset.ready) return; c.dataset.ready = '1';
        let sv = null; try { sv = localStorage.getItem('m2d-season'); } catch (e) {}
        try { d = createDiorama(c, { themeName: document.documentElement.dataset.theme || 'yellow', seasonName: ['spring', 'summer', 'autumn', 'winter'].includes(sv) ? sv : undefined, lite: true }); }
        catch (e) { console.warn('背景の町を初期化できません', e); c.remove(); }
      }
      document.addEventListener('m2d:theme', (e) => { if (d) d.applyTheme(e.detail); });
      document.addEventListener('m2d:season', (e) => { if (d) d.applySeason(e.detail); });
      document.addEventListener('astro:before-swap', () => { if (d) { d.dispose(); d = null; } });
      document.addEventListener('astro:after-swap', () => { window.__m2dSwapped = true; });
      document.addEventListener('astro:page-load', init);
      init();
    </script>
  </body>
</html>
