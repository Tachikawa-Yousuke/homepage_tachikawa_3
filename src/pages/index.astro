---
// トップ: 一本の巨大なナノワイヤの塔（3D ジオラマ）の上に文章を重ねる。テーマは黄 / 黒を切替。
import site from '../data/site.json';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/url';
import { PLACES } from '../lib/town';
import { ClientRouter } from 'astro:transitions';
import SiteChrome from '../components/SiteChrome.astro';

const research = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
const news = (await getCollection('news')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 4);
const publications = await getCollection('publications');
const equipment = await getCollection('equipment');
const members = await getCollection('members');
const fmt = (d: Date) => d.toISOString().slice(0, 10).replace(/-/g, '.');
const pageTitle = site.labName + '｜' + site.labNameAlt + ' - ' + site.universityEn;
const nav = [
  { href: withBase('/about'), label: '研究室概要' }, { href: withBase('/research'), label: '研究テーマ' }, { href: withBase('/members'), label: 'メンバー' },
  { href: withBase('/publications'), label: '業績' }, { href: withBase('/equipment'), label: '装置・設備' }, { href: withBase('/join'), label: '進学・配属' }, { href: withBase('/access'), label: 'アクセス' },
];
const mapUrl = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent('九州大学 伊都キャンパス ウエスト4号館');
// 模型上の目印（位置は diorama.js の HOTSPOTS と対応）
const spots = [
  { key: 'message', en: 'Message', label: 'メッセージ', href: '#message', desc: '研究室からのメッセージ。「誰もが簡単に、小さなモノづくりを。」目指していること、取り組み、問い合わせ先。' },
  { key: 'about', en: 'About', label: '研究室概要', href: withBase('/about'), desc: site.foundedText + '。固体中の原子拡散を駆使した、原子・ナノスケールのモノづくりに挑む研究室です。' },
  { key: 'research', en: 'Research', label: '研究テーマ', href: withBase('/research'), desc: research.length + ' つのテーマ。ナノワイヤ創製、Nano Additive Manufacturing、電子と欠陥、結晶組織デザイン。' },
  { key: 'members', en: 'Members', label: 'メンバー', href: withBase('/members'), desc: '教員・学生 ' + members.filter((m) => m.data.group !== 'alumni').length + ' 名の小さな研究室。メンバーを募集しています。' },
  { key: 'publications', en: 'Publications', label: '業績', href: withBase('/publications'), desc: '査読付き論文 ' + publications.length + ' 件を掲載（2024 年以降分。順次追加）。' },
  { key: 'equipment', en: 'Apparatus', label: '装置・設備', href: withBase('/equipment'), desc: '成膜・焼結から電子顕微鏡その場観察まで、' + equipment.length + ' 点の装置。' },
  { key: 'join', en: 'Join us', label: '進学・配属', href: withBase('/join'), desc: '研究室見学・Web 面談は随時受け付けています。学部生も大学院進学希望者も歓迎。' },
  { key: 'access', en: 'Access', label: 'アクセス', href: withBase('/access'), desc: '伊都キャンパス ウエスト4号館 428・414・401 室。問い合わせはフォームから。' },
];
// 町の場所名（メニューと同じ語彙）と、板で開く目印（文章ページの中身を読み込む）。メンバー・業績は長いのでページへ移動する
const PANEL_SPOTS = ['about', 'research', 'equipment', 'join', 'access'];
for (const sp of spots) { sp.place = PLACES.find((p) => p.en === sp.en)?.place || ''; sp.panel = PANEL_SPOTS.includes(sp.key); }
const themes = [
  { key: 'yellow', label: '黄' }, { key: 'navy', label: '紺' }, { key: 'green', label: '緑' }, { key: 'black', label: '黒' },
];
---
<!doctype html>
<html lang="ja" data-theme="yellow">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={site.description} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href={withBase('/style.css')} />
    <script is:inline>
      // テーマの初期化（描画前に反映して、ちらつきを防ぐ）
      try { var th = localStorage.getItem('m2d-theme'); if (['yellow', 'navy', 'green', 'black'].indexOf(th) >= 0) document.documentElement.dataset.theme = th; } catch (e) {}
    </script>
    <ClientRouter />
  </head>
  <body>
    <!-- 看板イントロを出すときは、最初の描画から名称・見出しを隠しておく（diorama.js が終了時に外す。JS 無効時はこのスクリプトも走らないので表示される） -->
    <script is:inline>try { if (!location.hash && !matchMedia('(prefers-reduced-motion: reduce)').matches) document.body.classList.add('intro'); } catch (e) {}</script>
    <canvas id="diorama" data-base={import.meta.env.BASE_URL} aria-label="大きな一本の木を中心にした町の 3D 模型"></canvas>
    <noscript><div class="nojs"><p>3D 模型の表示には JavaScript が必要です。</p></div></noscript>
    <svg class="leader" id="leader" aria-hidden="true"><path d="" /></svg>
    <div id="trail" aria-hidden="true"></div>   <!-- ランニング人形が土台の外へ出ると、ここに足跡が下から上へ付いて消える -->
    <div id="markers" aria-label="模型上のリンク">
      {spots.map((sp) => <a class="marker" data-spot={sp.key} data-place={sp.place} data-panel={sp.panel ? '1' : undefined} href={sp.href}><i></i><span>{sp.label}</span></a>)}
    </div>

    <!-- メッセージ板: 大木の目印「メッセージ」をクリックで左から出る。中身はキャッチコピー → 紹介文 → 問い合わせ -->
    <div id="msg-shade" class="msg-shade" aria-hidden="true"></div>
    <aside id="message" class="msg-panel" aria-label="メッセージ" aria-hidden="true">
      <button class="msg-close" type="button" aria-label="閉じる">×</button>
      <span class="en">Message</span>
      <h1 class="hero-catch">誰もが簡単に、<br />小さなモノづくりを。</h1>
        <div class="hero-intro">
          <p><b>見えないほど小さな世界に、<br />誰もが使えるモノづくりを。</b>当研究室は、工学イノベーションを切り拓くことをミッションに2024年9月に発足した研究室です。新たなGame changerとして原子・ナノ・マイクロといった目に見えない極小スケールにおいて、誰もが簡単に使えるモノづくり技術の創出を目指しています。</p>
          <p><b>小さな材料の壁を越える。</b>目に見えないほど小さな材料は、これまでの常識から外れた新しい材料機能を示しますが、創製難易度が高く、普及に至っていません。突破するために、固相中の物質輸送現象である原子拡散を駆使した新しい「原子・ナノスケールのモノづくり」を提案しています。</p>
          <p><b>見て、測って、操る。</b>その他、その場電子顕微鏡観察や数値計算技術を採り入れた電子と原子の相互作用の探究、結晶組織操作による金属・セラミックスの力学特性向上手法を開発したりしています。</p>
          <p><b>力学を土台に、新しい科学へ。</b>本研究室は力学を基盤とした実験研究を中心に据えています。基礎物理を理解しながら新しい科学の発展を目指しています。材料が好き、ナノ（小さいもの）に興味を持っている、原子を見たい、新しい技術や知識に触れてみたい、とにかく突き詰めて考えることが好き、など一つでも当てはまって興味がある人はぜひ<a href={site.contactFormUrl} target="_blank" rel="noopener">問い合わせフォーム</a>から気軽にお問い合わせください（メールでもOKです）。研究室見学やWeb面談は随時受け付けています。</p>
        </div>
      <a class="hero-cta" href={site.contactFormUrl} target="_blank" rel="noopener"><span class="cta-main">お問い合わせフォーム ▶</span><span class="cta-sub">研究室見学・Web 面談は随時受付中</span></a>
    </aside>
    <!-- 場所の板: 研究棟・大木の枝・装置棟・立て看板・郵便受けの目印をクリックで、その文章ページの中身をここに読み込んで出す -->
    <aside id="place" class="msg-panel place-panel" aria-label="場所の案内" aria-hidden="true">
      <button class="msg-close" type="button" aria-label="閉じる">×</button>
      <p class="crumb"><span>M2D TOWN</span><span aria-hidden="true">▸</span><span class="place-name"></span></p>
      <div class="place-body"></div>
      <p class="place-foot"><a class="place-more" href="#">このページを全画面で開く ▶</a></p>
    </aside>

    <SiteChrome />

    <div class="content">
      <!-- タウンビュー: 模型が中央寄り（やや右）に来て、ゆっくり自転。左に M2D TOWN -->
      <section class="model-stage" id="town" aria-label="タウンビュー">
        <div class="town-name">
          <p class="org-top">九州大学大学院 工学研究院 機械工学部門</p>
          <p class="lab-name">材料創製力学研究室｜木村研究室</p>
          <p class="label">Mechanics for Material Design (M2D) Lab | KIMURA Laboratory</p>
          <p class="org">Department of Mechanical Engineering, Kyushu University</p>
        </div>
        <div class="town-title" aria-hidden="true"><span class="en">Town view</span>M2D<br />TOWN</div>
        <div class="spot-panel" aria-live="polite">
          {spots.map((sp) => <div class="spot-info" data-for={sp.key}><span class="en">{sp.place} · {sp.en}</span><h3>{sp.label}</h3><p>{sp.desc}</p></div>)}
        </div>
      </section>

      <footer class="footer wrap">&copy; {new Date().getFullYear()} {site.labNameEn} / {site.universityEn}</footer>
    </div>

    <script>
      import { createDiorama } from '../scripts/diorama.js';
      let d = null;
      const current = () => document.documentElement.dataset.theme || 'yellow';
      function init() {
        const canvas = document.getElementById('diorama');
        if (!canvas || canvas.dataset.ready) return;
        canvas.dataset.ready = '1';
        const SEASONS = ['spring', 'summer', 'autumn', 'winter'];
        let sv = null; try { sv = localStorage.getItem('m2d-season'); } catch (e) {}
        const intro = !location.hash && !window.__m2dSwapped;   // 直接開いたときだけ、看板に寄った状態から引く
        try { d = createDiorama(canvas, { themeName: current(), seasonName: SEASONS.includes(sv) ? sv : undefined, base: canvas.dataset.base || '/', intro }); window.__d = d; }
        catch (e) { console.warn('WebGL を初期化できません', e); canvas.style.display = 'none'; document.body.classList.remove('intro'); }
      }
      document.addEventListener('m2d:theme', (e) => { if (d) d.applyTheme(e.detail); });
      document.addEventListener('m2d:season', (e) => { if (d) d.applySeason(e.detail); });
      // 目印にカーソルを合わせると、説明を出し、点線を結ぶ
      document.addEventListener('pointerover', (e) => {
        const m = e.target instanceof Element ? e.target.closest('.marker') : null; if (!m) return;
        document.querySelectorAll('.marker.hover').forEach((x) => x.classList.remove('hover'));
        document.querySelectorAll('.spot-info.on').forEach((x) => x.classList.remove('on'));
        m.classList.add('hover');
        const info = document.querySelector('.spot-info[data-for="' + m.dataset.spot + '"]'); if (info) info.classList.add('on');
      });
      document.addEventListener('pointerout', (e) => {
        const m = e.target instanceof Element ? e.target.closest('.marker') : null; if (!m) return;
        if (e.relatedTarget instanceof Element && e.relatedTarget.closest('.marker') === m) return;
        m.classList.remove('hover');
      });
      // ---- 板の開閉: メッセージ（#message）と場所の板（#about などは文章ページの中身を読み込んで表示）。開くとカメラがその目印に寄る ----
      const PANEL_SPOTS = ['about', 'research', 'equipment', 'join', 'access'];
      const placeCache = {};
      let openKey = null;
      const setHash = (h) => { try { history.replaceState(null, '', h ? '#' + h : location.pathname + location.search); } catch (e) {} };
      async function loadPlace(key) {
        const marker = document.querySelector('.marker[data-spot="' + key + '"]'), panel = document.getElementById('place'); if (!marker || !panel) return;
        const body = panel.querySelector('.place-body');
        panel.querySelector('.place-name').textContent = marker.dataset.place || '';
        panel.querySelector('.place-more').href = marker.href;
        if (!placeCache[key]) {
          body.innerHTML = '<p class="place-loading">読み込み中…</p>';
          try {
            const html = await (await fetch(marker.href, { credentials: 'same-origin' })).text();
            const doc = new DOMParser().parseFromString(html, 'text/html');
            const main = doc.querySelector('main.page'); main?.querySelector('.crumb')?.remove();
            placeCache[key] = main ? main.innerHTML : '<p>読み込めませんでした。</p>';
          } catch (e) { placeCache[key] = '<p>読み込めませんでした。<a href="' + marker.href + '">ページを開く</a></p>'; }
        }
        if (openKey === key) { body.innerHTML = placeCache[key]; panel.scrollTop = 0; }
      }
      function openSpot(key) {   // key: 'message' | PANEL_SPOTS のどれか | null（閉じる）
        openKey = key;
        const isMsg = key === 'message', isPlace = !!key && PANEL_SPOTS.includes(key);
        document.body.classList.toggle('msg-open', isMsg); document.body.classList.toggle('place-open', isPlace);
        document.getElementById('message')?.setAttribute('aria-hidden', String(!isMsg));
        document.getElementById('place')?.setAttribute('aria-hidden', String(!isPlace));
        if (isPlace) loadPlace(key);
        if (d) d.focus(isMsg || isPlace ? key : null);
        setHash(isMsg || isPlace ? key : null);
      }
      const spotFromHash = () => { const k = location.hash.slice(1); return k === 'message' || PANEL_SPOTS.includes(k) ? k : null; };
      if (!window.__m2dSpotBound) {
        window.__m2dSpotBound = true;
        // capture 段階で拾い、ClientRouter（ページ遷移）より先に止める。そうしないと板が開く前に /about などへ移動してしまう
        document.addEventListener('click', (e) => {
          const t = e.target instanceof Element ? e.target : null; if (!t) return;
          const m = t.closest('.marker'); if (m && (m.dataset.spot === 'message' || m.dataset.panel)) { e.preventDefault(); e.stopPropagation(); openSpot(m.dataset.spot); return; }
          if (t.closest('a[href$="#message"]')) { e.preventDefault(); e.stopPropagation(); openSpot('message'); document.body.classList.remove('nav-open'); document.getElementById('drawer')?.setAttribute('aria-hidden', 'true'); return; }   // メニューの「大木のてっぺん」（メニューは閉じる）
          if (t.closest('.msg-close, #msg-shade')) openSpot(null);
        }, true);
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && openKey) openSpot(null); });
        addEventListener('hashchange', () => openSpot(spotFromHash()));
        document.addEventListener('astro:page-load', () => { const k = spotFromHash(); if (k) openSpot(k); });
      }
      document.addEventListener('astro:before-swap', () => { if (d) { d.dispose(); d = null; } openKey = null; });
      document.addEventListener('astro:after-swap', () => { window.__m2dSwapped = true; });   // サイト内の移動で来たときは看板イントロを出さない
      document.addEventListener('astro:page-load', init);
      init();
      { const k = spotFromHash(); if (k) openSpot(k); }
    </script>
  </body>
</html>
